{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "atha-decoration/website",
    "type": "project",
    "description": "Wedding organizer website for Atha Decoration.",
    "keywords": ["laravel", "wedding-organizer"],
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-intl": "*",
        "ext-pdo_mysql": "*",
        "ext-zip": "*",
        "filament/filament": "^5.0",
        "laravel/fortify": "^1.0",
        "laravel/framework": "^13.17",
        "laravel/socialite": "^5.31",
        "laravel/tinker": "^3.0",
        "socialiteproviders/apple": "^6.1",
        "socialiteproviders/microsoft": "^4.10"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^2.9",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently --kill-others --names=laravel,vite \"php artisan serve --host=127.0.0.1\" \"npm run dev\""
        ],
        "check": [
            "@composer validate --strict",
            "@composer check-platform-reqs",
            "@php vendor/bin/pint --test",
            "@test"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": ["laravel/fortify", "laravel/passkeys"]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.4.0"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
